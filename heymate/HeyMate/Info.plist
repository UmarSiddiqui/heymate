<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GIDClientID</key>
    <string>554870227003-ngka8narrkfheeo8m96a9hruk8sgdgdc.apps.googleusercontent.com</string>
    <!-- Public project token, never a PostHog personal or secret API key. -->
    <key>POSTHOG_API_KEY</key>
    <string>$(POSTHOG_API_KEY)</string>
    <key>POSTHOG_HOST</key>
    <string>$(POSTHOG_HOST)</string>
	<key>HeyMateBuildSourceSHA256</key>
	<string>$(HEYMATE_BUILD_SOURCE_SHA256)</string>
	<key>HeyMateBuildKind</key>
	<string>$(HEYMATE_BUILD_KIND)</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>VoiceTranscriptionProvider</key>
	<string>parakeet</string>
	<key>VoiceSpeakProvider</key>
	<string>kokoro</string>
	<key>WorkerBaseURL</key>
	<string>http://localhost:8787</string>
	<!-- release.sh supplies both values together while archiving. They remain
	     empty in source and Debug builds, where AppUpdateController stays inert. -->
	<key>SUFeedURL</key>
	<string>$(SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<!-- Updates without questions: check every 6 hours, download in the
	     background, install when HeyMate quits or the person says so. Same
	     signing certificate every release, so permissions carry over. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<!-- heymate:// deep links. Two hosts:
	       heymate://integration/callback?provider=…&status=…  (connector OAuth)
	       heymate://open/agents                                (open a desktop section) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array><string>com.googleusercontent.apps.554870227003-ngka8narrkfheeo8m96a9hruk8sgdgdc</string></array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.heymate.app.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>heymate</string>
			</array>
		</dict>
	</array>
	<!-- OpenCodeClient permits plain HTTP only on loopback and requires HTTPS
	     for every non-loopback server before sending prompts or credentials. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>HeyMate uses your microphone so you can talk to it</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>HeyMate needs screen recording access to see your screen and help you.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>HeyMate uses speech recognition to transcribe your voice when you talk to it</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>HeyMate shows your next event in the notch and can create events when you ask it to.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>HeyMate can capture reminders by voice and read back what is due.</string>
	<key>NSContactsUsageDescription</key>
	<string>HeyMate looks up contacts so drafts go to the right person.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>HeyMate controls apps you connect — playing music, drafting mail, running a shortcut — and always asks before anything is sent.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>HeyMate shows headphones and other Bluetooth devices in the notch as they connect and disconnect.</string>
	<key>NSCameraUsageDescription</key>
	<string>HeyMate can show a camera mirror in the notch so you can check your appearance before a call.</string>
</dict>
</plist>
