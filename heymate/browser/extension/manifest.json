{
  "manifest_version": 3,
  "name": "HeyMate",
  "version": "0.4.0",
  "description": "Lets HeyMate work in your signed-in Chrome, inside a HeyMate tab group, through Chrome's debugger.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "HeyMate"
  }
}
